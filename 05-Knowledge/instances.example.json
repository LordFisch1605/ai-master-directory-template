{
  "interval_seconds": 300,
  "package": "mcp-local-rag@0.23.1",
  "cache_dir": "~/ai-master-directory/05-Knowledge/.models",
  "model": "onnx-community/embeddinggemma-2-ONNX",
  "instances": {
    "knowledge": {
      "roots": [
        "~/ai-master-directory/01-Tasks",
        "~/ai-master-directory/03-Uni",
        "~/ai-master-directory/02-Projects"
      ],
      "ignore": [
        "**/_raw/**",
        "**/_rohdaten/**",
        "**/_derived/**",
        "**/dist/**",
        "**/build/**",
        "**/.venv/**",
        "**/cache/**",
        "**/.claude/**"
      ],
      "db": "~/ai-master-directory/05-Knowledge/.index/knowledge",
      "visual": "quality"
    },
    "raw": {
      "discover": {
        "under": ["~/ai-master-directory/01-Tasks", "~/ai-master-directory/03-Uni"],
        "dirs": ["_raw", "_rohdaten", "_derived"]
      },
      "db": "~/ai-master-directory/05-Knowledge/.index/raw",
      "report_unconverted": true
    },
    "work": {
      "roots": ["~/work-vault/docs"],
      "db": "~/work-vault/.index/work"
    }
  }
}
